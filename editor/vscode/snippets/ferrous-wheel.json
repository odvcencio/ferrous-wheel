{
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant1},",
      "\t${3:Variant2},",
      "}"
    ],
    "description": "FW enum (sum type) declaration"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:pattern} => ${3:body},",
      "}"
    ],
    "description": "FW match expression"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "\t$0",
      "}"
    ],
    "description": "FW impl block for method definitions"
  },
  "Let Binding": {
    "prefix": "let",
    "body": ["let ${1:name} = ${2:value}"],
    "description": "FW immutable let binding"
  },
  "Let Mut Binding": {
    "prefix": "letmut",
    "body": ["let mut ${1:name} = ${2:value}"],
    "description": "FW mutable let binding"
  },
  "Guard Statement": {
    "prefix": "guard",
    "body": [
      "guard ${1:condition} else {",
      "\t${2:return}",
      "}"
    ],
    "description": "FW guard early-return statement"
  },
  "Fan Out": {
    "prefix": "fan",
    "body": [
      "fan {",
      "\t${1:task1}",
      "\t${2:task2}",
      "}"
    ],
    "description": "FW fan-out concurrency block"
  },
  "Retry": {
    "prefix": "retry",
    "body": [
      "retry(${1:3}) {",
      "\t$0",
      "}"
    ],
    "description": "FW retry block with attempt count"
  },
  "Breaker": {
    "prefix": "breaker",
    "body": [
      "breaker ${1:name} {",
      "\t$0",
      "}"
    ],
    "description": "FW circuit breaker block"
  },
  "Mmap": {
    "prefix": "mmap",
    "body": [
      "mmap ${1:name} = open(${2:\"path\"}, ${3:size})",
      "${1:name}.write(${4:offset}, ${5:data})"
    ],
    "description": "FW writable memory-mapped file"
  },
  "Select": {
    "prefix": "select",
    "body": [
      "select! {",
      "\t${1:chan1} => ${2:body1},",
      "\t${3:chan2} => ${4:body2},",
      "}"
    ],
    "description": "FW select! channel multiplexing"
  }
}
